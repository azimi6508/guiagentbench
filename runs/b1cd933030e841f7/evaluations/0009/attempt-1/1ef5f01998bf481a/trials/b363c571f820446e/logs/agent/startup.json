    {
      "name": "gui_step",
      "description": "One action: click/hover require x,y; scroll requires dx,dy; type requires text; press requires key; reload takes no other fields. Coordinates are integer pixels in the original screenshot, with top-left origin (0, 0). x increases right and y increases down. Use the screenshot width and height; coordinates are not percentages or a normalized 0-1000 scale. Alternatively click/hover/press can use exact role,name instead of coordinates/focus; fill requires role,name,text. Never mix targeting forms. No selectors, code, scripts, HTTP, test execution or action batches.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "click",
              "hover",
              "scroll",
              "type",
              "press",
              "reload",
              "fill"
